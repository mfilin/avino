<table
  border='0'
  cellpadding='0'
  cellspacing='0'
  width='100%'
  style='border-collapse: collapse'
>
  <tbody>
    <tr>
      <td style='border: 1px solid #000; padding: 10px 6px;'></td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >Название продукта</td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >Количество</td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >Цена</td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >Стоимость</td>

    </tr>
    {{#each products}}
      <tr>
        <td style='border: 1px solid #000; padding: 10px 6px;'>{{{tableIndex
            @index
          }}}</td>
        <td style='border: 1px solid #000; padding: 10px 6px;'>{{name}}</td>
        <td style='border: 1px solid #000; padding: 10px 6px;'>{{count}}</td>
        <td style='border: 1px solid #000; padding: 10px 6px;'>{{{priceFormat
            price
          }}}</td>
        <td style='border: 1px solid #000; padding: 10px 6px;'>{{{priceFormat
            priceTotal
          }}}</td>
      </tr>
    {{/each}}
    <tr>
      <td style='border: 1px solid #000; padding: 10px 6px;'></td>
      <td style='border: 1px solid #000; padding: 10px 6px;'></td>
      <td style='border: 1px solid #000; padding: 10px 6px;'></td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >Итого</td>
      <td
        style='border: 1px solid #000; padding: 10px 6px; font-weight: bold;'
      >{{{priceFormat info.total}}}</td>
    </tr>
  </tbody>
</table>