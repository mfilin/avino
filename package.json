  "scripts": {
    "build": "cross-env NODE_ENV=production concurrently --kill-others \"yarn run start:nest:prod:no-next\" \"yarn run build:next\"",
    "build:nest": "cross-env NODE_ENV=production nest build",
    "build:next": "next build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=production nest start",
    "start:nest:prod:no-next": "cross-env NODE_ENV=production nest start --webpackPath webpack.nest.config.js -- --skip-next-middleware",
    "start:dev": "cross-env NODE_ENV=development nest start --webpack --webpackPath webpack.nest.config.js --watch",
    "start:dev:no-next": "cross-env NODE_ENV=development nest start --webpack --webpackPath webpack.nest.config.js --watch  -- --skip-next-middleware",
    "start:debug": "nest start --webpack --webpackPath webpack.nest.config.js --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "export-catalog-to-elastic": "ts-node ./src/console.ts export-catalog-to-elastic",
    "export-catalog-to-json": "ts-node ./src/console.ts export-catalog-to-json",
    "generate-elastic-fake-products": "ts-node ./src/console.ts generate-elastic-fake-products",
    "admin": "ts-node ./src/console.ts admin",
    "migration": "ts-node ./src/console.ts migration",
    "new-migration": "ts-node ./src/console.ts migration create"
  },
